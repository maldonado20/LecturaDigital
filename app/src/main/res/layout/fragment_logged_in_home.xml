<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo"
    android:gravity="center_horizontal"
    tools:context=".LoggedInHomeFragment">

    <LinearLayout
        android:id="@+id/llFeaturedBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fondo"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:gravity="center_horizontal"
        android:visibility="gone"> <ImageView
        android:id="@+id/ivFeaturedBookCover"
        android:layout_width="180dp"
        android:layout_height="250dp"
        android:scaleType="centerCrop"
        android:src="@color/seccion"
        android:contentDescription="Portada" />

        <TextView
            android:id="@+id/tvFeaturedBookTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título"
            android:textColor="@color/nav"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvWelcomeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido de nuevo"
        android:textColor="@color/nav"
        android:textSize="22sp"
        android:layout_marginTop="100dp"
        android:visibility="gone"/> <ProgressBar
    android:id="@+id/pbCargandoLogin"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="100dp"
    android:visibility="visible" /> </LinearLayout>